# Server
# PORT is optional: the host (Render) supplies one, and index.js defaults to 5000.
PORT=5000
# NODE_ENV=production turns on the Secure cookie flag; the host sets it in deployment.
NODE_ENV=development
# Comma-separated allow-list of origins. Scheme included, no trailing slash; whitespace and
# trailing slashes are trimmed. Any origin not listed is rejected, and '*' is never used.
# Production value (Vercel site + Capacitor Android WebView + localhost):
CLIENT_ORIGIN=https://fams-psi.vercel.app,https://localhost,http://localhost
# Local development additionally needs the Vite dev server:
# CLIENT_ORIGIN=http://localhost:5173
# Optional. 'none' | 'lax' | 'strict'; defaults to 'none' in production, 'lax' otherwise.
# Only set it to 'lax'/'strict' when the client and API share a registrable domain.
COOKIE_SAME_SITE=

# MongoDB
MONGO_URI=mongodb://localhost:27017/fams

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d
COOKIE_EXPIRE=7

# Outbound email (verification codes) through Resend's HTTPS API. Render's free tier blocks
# outbound SMTP ports, so email must go over HTTPS. Leave RESEND_API_KEY blank to disable sending.
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=
# Sender address. Leave blank for Resend's sandbox sender onboarding@resend.dev, which can
# deliver only to the Resend account owner's own address until a domain is verified. For real
# beneficiaries, verify a domain at https://resend.com/domains and use an address on it.
MAIL_FROM=
MAIL_FROM_NAME=FAMS

# Cloudinary (reserved for a later implementation day)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Firebase (reserved for a later implementation day)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_client_email
FIREBASE_PRIVATE_KEY=your_private_key
