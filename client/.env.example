# Client build-time variables. Vite inlines every VITE_* variable into the bundle while
# building, so on Vercel this has to be set in the project's Environment Variables before the
# build runs. Changing it later requires a redeploy, not a restart.
#
# Local development: leave it unset. When VITE_API_URL is absent the axios client falls back
# to http://localhost:5001/api in client/src/services/api.js.
#
# Deployment (Vercel): the Render service URL, with the /api suffix and no trailing slash.
# VITE_API_URL=https://fams-api.onrender.com/api
